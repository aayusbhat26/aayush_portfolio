# Absolute site origin used for canonical URLs, Open Graph images, robots.txt and sitemap.xml.
# Set this to the deployed origin (no trailing slash), for example:
# NEXT_PUBLIC_SITE_URL=https://aayush.example
NEXT_PUBLIC_SITE_URL=

# Optional GoatCounter site code (free). Leave empty to ship without analytics.
NEXT_PUBLIC_GOATCOUNTER_CODE=
